# Dev-Container für FAUP (WiSe 2026/27)
# Wird lokal mit Podman gebaut (./dev.sh build); es gibt keine Registry.
FROM debian:trixie

ARG OPENCODE_VERSION=1.18.35
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build gdb \
        clang clang-format clang-tidy libclang-rt-19-dev \
        libgtest-dev libgmock-dev gcovr \
        git ca-certificates curl less nano ripgrep file \
    && rm -rf /var/lib/apt/lists/*

# OpenCode: feste Version, damit alle dieselbe haben
RUN case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
        amd64) arch=x64 ;; arm64) arch=arm64 ;; \
        *) echo "Architektur nicht unterstützt" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/opencode-linux-${arch}.tar.gz" \
       | tar -xz -C /usr/local/bin opencode \
    && opencode --version

# Claude Code aus dem signierten apt-Repository von Anthropic (Kanal "stable").
# Der Schlüssel wird beim Bauen gegen den veröffentlichten Fingerabdruck geprüft;
# gnupg wird nur dafür gebraucht und danach wieder entfernt.
ARG CLAUDE_KEY_FPR=31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE
RUN apt-get update && apt-get install -y --no-install-recommends gnupg \
    && install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://downloads.claude.ai/keys/claude-code.asc \
       -o /etc/apt/keyrings/claude-code.asc \
    && gpg --show-keys --with-colons /etc/apt/keyrings/claude-code.asc \
       | grep -qx "fpr:::::::::${CLAUDE_KEY_FPR}:" \
    && echo "deb [signed-by=/etc/apt/keyrings/claude-code.asc] https://downloads.claude.ai/claude-code/apt/stable stable main" \
       > /etc/apt/sources.list.d/claude-code.list \
    && apt-get update && apt-get install -y --no-install-recommends claude-code \
    && apt-get purge -y --auto-remove gnupg \
    && rm -rf /var/lib/apt/lists/* \
    && claude --version

# Eigene Pakete: Zeilen einkommentieren, Pakete eintragen, dann ./dev.sh build
# RUN apt-get update && apt-get install -y --no-install-recommends \
#         paket1 paket2 \
#     && rm -rf /var/lib/apt/lists/*

# Das Projekt wird nach /work eingebunden, eventuell mit fremder UID
RUN git config --system safe.directory /work

# Benutzer dev (UID 1000); Podman bildet ihn per keep-id auf den eigenen Benutzer ab.
# Das Home liegt in einem Volume (Einstellungen von OpenCode, Git und Shell bleiben erhalten).
RUN useradd -m -u 1000 -s /bin/bash dev
USER dev
ENV HOME=/home/dev \
    FAUP_DEV=1

WORKDIR /work
CMD ["bash"]
